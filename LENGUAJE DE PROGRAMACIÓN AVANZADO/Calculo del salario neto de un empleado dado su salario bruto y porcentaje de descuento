#include <stdio.h>

int main() {
    float salarioBruto, descuento, salarioNeto;

    printf("Ingrese el salario bruto del empleado: ");
    scanf("%f", &salarioBruto);

    printf("Ingrese el porcentaje de descuento: ");
    scanf("%f", &descuento);

    salarioNeto = salarioBruto - (salarioBruto * descuento / 100);

    printf("El salario neto del empleado es: $%.2f\n", salarioNeto);

    return 0;
}
